# Dependências (Playwright, ESLint e Prettier), instaladas por npm ci na raiz.
node_modules/
# Configuração local do Claude Code (plugins, worktrees temporários, permissões locais) — ferramenta
# de quem edita o repo, não parte dos apps. Nunca deve ir pro commit. Exceção: o hook de início das
# sessões na nuvem (instala o Playwright), que é do projeto.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/agents/
