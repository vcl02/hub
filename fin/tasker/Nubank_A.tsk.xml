			<Str sr="arg0" ve="3">// Lê a notificação do Nubank (só gasto): crédito, débito e NuPay. Qualquer outra coisa vira "nenhum" e para.
var s = (local("evtprm2") || "") + " | " + (local("evtprm3") || "");
var tipo = "", valor = "", estab = "", parcelas = "1", m;

if (m = s.match(/Compra de R\$\s?([\d.]+,\d{2}) APROVADA em (.+?) para o cartão com final (\d{4})/)) {
  tipo = "despesa_credito"; valor = m[1]; estab = m[2];
} else if (m = s.match(/R\$\s?([\d.]+,\d{2}) em (\d+)x no crédito.*?APROVADO em (.+?)\.?$/)) {
  tipo = "despesa_credito"; valor = m[1]; parcelas = m[2]; estab = m[3];
} else if (/débito/i.test(s) &amp;&amp; (m = s.match(/Compra de R\$\s?([\d.]+,\d{2}) em (.+?)\.?\s*$/))) {
  tipo = "despesa_debito"; valor = m[1]; estab = m[2];
} else if (/boleto/i.test(s) &amp;&amp; /\b(pago|paga|realizad[oa]|confirmad[oa]|efetuad[oa])\b/i.test(s) &amp;&amp;
           !/venc|agendad|lembrete/i.test(s) &amp;&amp; (m = s.match(/R\$\s?([\d.]+,\d{2})/))) {
  // Boleto pago (texto ainda sem print: lembrete, agendamento e "vence" ficam de fora): sai da conta, como débito.
  tipo = "despesa_debito"; valor = m[1];
  var q = s.match(/\bpara\s+(.+?)\s*(?:\s(?:foi|com sucesso)\b|\.(?:\s|$)|\||$)/i);
  estab = q ? q[1] : "Boleto";
}

setLocal("tipo", tipo || "nenhum");
setLocal("valor", valor.replace(/\./g, "").replace(",", "."));
setLocal("estab", estab);
setLocal("parcelas", parcelas);</Str>
